# Supabase Configuration
# Get these values from: https://app.supabase.com → Settings → API

# Project URL (e.g., https://xxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://hkzeujifvmgwqilkchdi.supabase.co

# Service Role Key (secret - keep private!)
# DO NOT use the "anon" public key - use the "service_role" secret key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server Port (optional, defaults to 3000)
PORT=3000

# ==============================================
# IMPORTANT SECURITY NOTES:
# ==============================================
# 1. Never commit .env file to Git
# 2. Service role key is for backend only
# 3. Do not expose service role key to frontend
# 4. Rotate keys if accidentally exposed
# 5. Use environment variables in production hosting
# ==============================================
